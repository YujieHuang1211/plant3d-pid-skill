{"clear": false, "items": [{"k": "text", "at": [30, 253], "text": "CO 0~200 ppm：AAH 10 / AAHH 20 ppm", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [30, 237], "text": "H\\S^2; 0~100 %LEL：AAH 10 / AAHH 20 %LEL", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [30, 221], "text": "CH\\S^4; 0~100 %LEL：AAH 10 / AAHH 20 %LEL", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [30, 181], "text": "急停（双触点）", "h": 3.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [30, 156], "text": "复位按钮", "h": 3.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [157, 204], "text": "UZ-401 安全继电器：双通道，手动复位；串联在 PLC DO 之后", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 262], "text": "急停 HS-401 按下", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 246], "text": "CO 高高 AAHH-401 或探测器故障", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 230], "text": "H\\S^2; 高高 AAHH-402 或探测器故障", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 214], "text": "CH\\S^4; 高高 AAHH-403 或探测器故障", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 274], "text": "硬件撤销许可：燃料 XV 关，XV-201 开，炉加热 XY-301 断，负载 XY-304 禁能", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [158, 152], "text": "PLC-401 S7-1200 CPU1214C（顺序控制与软件联锁，非安全 PLC）", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [216, 147], "text": "HMI-401 昆仑通态 TPC1031Nt 10″；以太网 VNC → 台式电脑；CSV 导出", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [70, 130], "text": "XA-401 总声光报警（DO10）", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 122], "text": "气体预警 AAH-401/402/403（探测器本机）", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 110], "text": "N\\S^2; 供应失效（FSL-201 未证明 / FIC-102 失流）", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [208, 98], "text": "炉超温 TSHH-301", "h": 2.5, "just": "ML", "layer": "注释"}, {"k": "text", "at": [308, 122], "text": "通信中断（MFC/炉/负载看门狗）", "h": 2.5, 